# ---- Telegram ----------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:replace-with-your-bot-token
# Your numeric Telegram user id (ask @userinfobot)
BOT_OWNER_ID=123456789
# Random secret, 32+ characters:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Private storage channel id (starts with -100). The bot must be an admin that can post.
STORAGE_CHANNEL_ID=-1001234567890

# ---- URLs ---------------------------------------------------------------------
# Exact frontend origin (no trailing slash), e.g. your Vercel domain
MINI_APP_URL=https://your-frontend.vercel.app
# Public HTTPS URL of this backend (used by `deno task webhook`)
APP_URL=https://your-backend.deno.dev

# ---- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key. Backend only - never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# ---- Security -----------------------------------------------------------------
# Random secret, 32+ characters, different from the webhook secret:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters

# ---- Optional -----------------------------------------------------------------
# Bot username without @. Detected automatically when empty.
BOT_USERNAME=
# Extra allowed browser origin for local development, e.g. http://localhost:5173
DEV_ORIGIN=
# Days before Trash and the activity log are purged automatically (default 30)
TRASH_RETENTION_DAYS=30
ACTIVITY_RETENTION_DAYS=30
PORT=8000
